# Backend configuration. Copy to .env (a ready-to-use .env is already included).
PORT=4000
# Folder for reports.json and uploads (relative to backend/)
DATA_DIR=data
# Browser origin allowed to call the API (the Vite dev server)
CORS_ORIGIN=http://localhost:5173
# Only "stub" exists until the Gemini integration is wired in src/triage.js
TRIAGE_MODE=stub
# Give up on the AI call after this many milliseconds
TRIAGE_TIMEOUT_MS=8000
# Seed 5 demo reports when the data folder is empty
SEED_DEMO_DATA=true
# Secret - intentionally blank. Only needed after the manual Gemini wiring; never commit a real key.
GEMINI_API_KEY=
