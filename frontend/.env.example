# Frontend configuration. Copy to .env (a ready-to-use .env is already included).

# Intentionally blank in development: Vite proxies /api and /uploads to the target below.
# Set to the API's public URL only when the frontend is deployed separately.
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://localhost:4000

# Map. Defaults use CARTO Voyager tiles, which need a FREE key: https://carto.com/basemaps/apikey
# Paste your key below. It is sent from the browser, so restrict it by domain at https://dashboard.basemaps.carto.com
VITE_MAP_API_KEY=
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors © CARTO
VITE_MAP_CENTER_LAT=21.1458
VITE_MAP_CENTER_LNG=79.0882
VITE_MAP_ZOOM=13
